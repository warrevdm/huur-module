APP_NAME="Aerts Action Bike Verhuur"
APP_ENV=production
APP_DEBUG=0
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Brussels
SESSION_NAME=aab_huur_session
DB_PATH=storage/database.sqlite

COMPANY_NAME="Aerts Action Bike"
COMPANY_ADDRESS="Kapellensteenweg 394, 2920 Kalmthout"
COMPANY_EMAIL=info@aertsactionbike.be
COMPANY_PHONE=
COMPANY_VAT=

ADMIN_NAME="Beheerder"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

ID_MAX_MB=8
ID_RETENTION_DAYS=30
BIKE_IMAGE_MAX_MB=8

# log = lokaal testbestand, smtp = echte verzending, mail = PHP mail()
MAIL_TRANSPORT=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@aertsactionbike.be
MAIL_FROM_NAME="Aerts Action Bike"

# Microsoft Graph contractmail
# Mail.Send = Application permission + Admin consent vereist.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FROM_ADDRESS=verkoop@aertsactionbike.be

# Security
CONTRACT_TOKEN_TTL_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
